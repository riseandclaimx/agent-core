{
  "name": "agent-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "slack:manifest": "tsx scripts/generate-slack-manifest.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.1.0",
    "@slack/types": "^2.12.0",
    "@upstash/qstash": "^2.0.0",
    "@upstash/redis": "^1.32.0",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.4",
    "zod": "^3.23.8",
    "ulid": "^2.3.0",
    "crypto-js": "^4.2.0",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241201.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.5.0",
    "drizzle-kit": "^0.24.0",
    "eslint": "^9.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.80.0"
  }
}