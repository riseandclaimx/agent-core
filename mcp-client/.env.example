# MCP Server connection
MCP_SERVER_URL=http://localhost:8080/mcp
MCP_API_KEY=your-mcp-api-key

# LLM Provider keys (at least one required)
GROQ_API_KEY=your-groq-key
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GITHUB_TOKEN=               # GitHub PAT — for GitHub Models (free GPT-4o etc.)
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=           # MoonshotAI / Kimi
KILO_API_KEY=               # Kilo AI (coding)

# Client settings
PORT=3100
DEFAULT_MODEL=groq:openai/gpt-oss-20b
MAX_TOOL_ROUNDS=10
