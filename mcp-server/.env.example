# Required
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
ENCRYPTION_KEY=your-32-byte-base64url-key

# Auth (leave empty for dev/open mode)
MCP_API_KEY=your-secret-api-key

# Embedding providers (optional — falls back to pseudo-embeddings)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server
PORT=8080
