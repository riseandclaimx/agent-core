  "routingRules": [
    {
      "name": "simple_qa",
      "conditions": {
        "taskTypes": ["general", "qa", "explanation"],
        "maxComplexity": "low",
        "requiresTools": false
      },
      "model": "groq:openai/gpt-oss-20b",
      "fallback": ["gemini:gemini-2.5-flash", "github:gpt-4o"]
    },
    {
      "name": "tool_use",
      "conditions": {
        "taskTypes": ["general", "automation", "data_retrieval"],
        "requiresTools": true
      },
      "model": "groq:openai/gpt-oss-20b",
      "fallback": ["gemini:gemini-2.5-flash", "deepseek:deepseek-chat", "github:gpt-4o"]
    },
    {
      "name": "coding",
      "conditions": {
        "taskTypes": ["coding", "debugging", "code_review"]
      },
      "model": "mistral:codestral-latest",
      "fallback": ["kilo:kilo-coder", "groq:openai/gpt-oss-120b", "deepseek:deepseek-chat", "github:gpt-5"]
    },
    {
      "name": "complex_reasoning",
      "conditions": {
        "taskTypes": ["analysis", "planning", "strategy", "math"],
        "minComplexity": "high"
      },
      "model": "groq:openai/gpt-oss-120b",
      "fallback": ["deepseek:deepseek-reasoner", "moonshot:kimi-latest", "github:gpt-5"]
    },
    {
      "name": "long_context",
      "conditions": {
        "minContextTokens": 50000
      },
      "model": "gemini:gemini-2.5-flash",
      "fallback": ["gemini:gemini-1.5-pro", "moonshot:kimi-latest", "github:gpt-5"]
    },
    {
      "name": "vision",
      "conditions": {
        "requiresVision": true
      },
      "model": "gemini:gemini-2.5-flash",
      "fallback": ["github:gpt-4o", "gemini:gemini-1.5-pro"]
    },
    {
      "name": "rag_search",
      "conditions": {
        "taskTypes": ["search", "rag", "retrieval", "summarization"]
      },
      "model": "cohere:command-a-03-2025",
      "fallback": ["cohere:command-r-plus-08-2024", "gemini:gemini-2.5-flash", "groq:openai/gpt-oss-20b"]
    },
    {
      "name": "premium_escalation",
      "conditions": {
        "premium": true
      },
      "model": "github:gpt-5",
      "fallback": ["deepseek:deepseek-reasoner", "openrouter:anthropic/claude-sonnet-4"]
    }
  ],

  "costLimits": {
    "perRequestUsd": 0.5,
    "perUserDailyUsd": 5.0,
    "perTeamDailyUsd": 50.0
  }
}
