{
  "version": "2.0",
  "defaultModel": "groq:openai/gpt-oss-20b",

  "tiers": {
    "1_fast": {
      "description": "Speed layer — Groq. Handles most requests instantly.",
      "models": ["groq:openai/gpt-oss-20b", "groq:openai/gpt-oss-120b"]
    },
    "2_reasoning": {
      "description": "Deeper thinking — DeepSeek + Moonshot/Kimi.",
      "models": ["deepseek:deepseek-chat", "deepseek:deepseek-reasoner", "moonshot:kimi-latest"]
    },
    "3_workhorse": {
      "description": "Main workhorse — Gemini free tier, high limits, long context.",
      "models": ["gemini:gemini-2.5-flash", "gemini:gemini-2.0-flash", "gemini:gemini-1.5-pro"]
    },
    "4_premium": {
      "description": "Escalation — GitHub Models GPT-5 when lower tiers aren't enough.",
      "models": ["github:gpt-5", "github:gpt-4o"]
    },
    "specialty_coding": {
      "description": "Coding specialists — Mistral Codestral + Kilo AI.",
      "models": ["mistral:codestral-latest", "kilo:kilo-coder", "mistral:mistral-large-latest"]
    },
    "specialty_rag": {
      "description": "RAG/search/embeddings — Cohere's strength.",
      "models": ["cohere:command-a-03-2025", "cohere:command-r-plus-08-2024"]
    },
    "fallback": {
      "description": "OpenRouter as last-resort fallback to any model.",
      "models": ["openrouter:google/gemini-2.5-flash-preview", "openrouter:anthropic/claude-sonnet-4"]
    }
  },

