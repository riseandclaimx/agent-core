# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/agent_core

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...  # Optional: for Socket Mode (dev only)

# ── LLM Providers (at minimum set GROQ_API_KEY — it's free) ──────────────────
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=           # Optional
OPENAI_API_KEY=sk-...       # Optional
ANTHROPIC_API_KEY=sk-ant-.. # Optional
GEMINI_API_KEY=             # Optional (also used for embeddings)
CEREBRAS_API_KEY=           # Optional
GITHUB_TOKEN=               # Optional — GitHub PAT for GitHub Models (OpenAI-compatible)
MISTRAL_API_KEY=            # Optional
COHERE_API_KEY=             # Optional
OPENROUTER_API_KEY=         # Optional
MOONSHOT_API_KEY=           # Optional — MoonshotAI/Kimi
KILO_API_KEY=               # Optional — Kilo AI (coding)

# ── Upstash (async tasks + rate limiting) ─────────────────────────────────────
QSTASH_TOKEN=
QSTASH_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_URL=https://agent-core.<your-subdomain>.workers.dev
